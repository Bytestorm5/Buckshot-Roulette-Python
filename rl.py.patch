+def encode_state(
+    game: BuckshotRoulette,
+    me: int,
+    known_shells: List[Optional[bool]],
+    pad_map: List[Optional[int]],
+) -> torch.Tensor:
+    """
+    Encode public state + my private shell knowledge into a fixed-size vector.
+    - 4 relative player slots always. For 2/3p, some slots are 'dead' (0/0).
+    - Jam flags are aligned to the 4-slot padding layout.
+    - Full shell memory: up to 10 entries, two channels each (live_i, blank_i).
+    """
+    pc = game.player_count
+    SLOTS = 4
+
+    # Charges/alive per padded slot
+    start_charges = float(game.config.start_charges)
+    charges: List[float] = []
+    alive: List[float] = []
+    for slot in range(SLOTS):
+        off = pad_map[slot]
+        if off is None:
+            charges.append(0.0)
+            alive.append(0.0)
+        else:
+            idx = (me + off) % pc
+            c = game.charges[idx]
+            charges.append(c / max(1.0, start_charges))
+            alive.append(1.0 if c > 0 else 0.0)
