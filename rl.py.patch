+    def _build_pad_map(self, pc: int) -> List[Optional[int]]:
+        """Create a 4-slot layout with (4-pc) randomly placed dead pads."""
+        SLOTS = 4
+        slots = list(range(SLOTS))
+        dead = set(random.sample(slots, k=SLOTS - pc))
+        pad: List[Optional[int]] = []
+        cur = 0
+        for s in slots:
+            if s in dead:
+                pad.append(None)
+            else:
+                pad.append(cur)
+                cur += 1
+        return pad
